{
  "version": 2,
  "routes": [
    {
      "src": "/.*",
      "dest": "/public/index.html",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Frame-Options": "DENY"
      }
    },
     {
      "src": "/public/(.*)/(.*)\\.html",
      "dest": "/public/$1/$2.html",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Frame-Options": "DENY"
  }
}
  ],
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
