{
  "version": 2,
  "routes": [
    {
      "src": "/.*",
      "dest": "/public/index.html",
      "headers": {
        "Cache-Control": "public, max-age=3600",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "default-src 'self'"
      }
    },
    {
            "src": "/tmp/(.*)/(.*)\\.html",
            "dest": "/tmp/$1/$2.html"
    }
  ],
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
