{
    "version": 2,
    "builds": [
        {
            "src": "test.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/tmp/(.*)/(.*)\\.html",
            "dest": "/tmp/$1/$2.html"
        },
        {
            "src": "/",
            "dest": "/test.html"
        }
    ]
}
